generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
}

/// =======================
/// AUDIT LOG
/// =======================
model auditlog {
  id        BigInt   @id @default(autoincrement())
  action    String
  entity    String
  entityId  BigInt?
  adminId   BigInt?
  meta      String?  @db.LongText
  createdAt DateTime @default(now())
}

/// =======================
/// DRAW
/// =======================
model draw {
  id          BigInt  @id @default(autoincrement())
  title       String
  description String?

  bannerImage String? @db.Text
  rules       String? @db.LongText

  entryFee  Int
  startTime DateTime
  endTime   DateTime
  resultAt  DateTime?

  maxTickets Int
  status     draw_status @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drawproduct drawproduct[]
  payment     payment[]
  ticket      ticket[]
  winner      winner[]

  @@index([status])
  @@index([startTime])
  @@index([endTime])
}

/// =======================
/// DRAW PRODUCT
/// =======================
model drawproduct {
  id          BigInt   @id @default(autoincrement())
  drawId      BigInt
  name        String
  image       String?  @db.LongText
  quantity    Int
  description String?
  createdAt   DateTime @default(now())

  draw   draw     @relation(fields: [drawId], references: [id])
  winner winner[]

  @@index([drawId])
}

/// =======================
/// NOTIFICATION
/// =======================
model notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// =======================
/// PAYMENT
/// =======================
model payment {
  id     BigInt @id @default(autoincrement())
  userId BigInt
  drawId BigInt
  amount Int

  transactionId    String? @unique
  gatewayOrderId   String?
  gatewayPaymentId String?

  method        payment_method
  gateway       payment_gateway
  walletUsed    Int             @default(0)
  screenshot    String?
  failureReason String?

  status payment_status @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draw   draw    @relation(fields: [drawId], references: [id])
  user   user    @relation(fields: [userId], references: [id])
  ticket ticket?

  @@index([userId])
  @@index([drawId])
  @@index([status])
}

/// =======================
/// TICKET
/// =======================
model ticket {
  id         BigInt @id @default(autoincrement())
  ticketCode String @unique

  userId    BigInt
  drawId    BigInt
  paymentId BigInt? @unique

  pricePaid Int
  status    ticket_status @default(ACTIVE)

  source   ticket_source
  isWinner Boolean       @default(false)

  coverImage       String?
  createdByAdminId BigInt?
  createdAt        DateTime @default(now())

  user    user     @relation("UserTickets", fields: [userId], references: [id])
  draw    draw     @relation(fields: [drawId], references: [id])
  payment payment? @relation(fields: [paymentId], references: [id])
  winner  winner?

  @@index([userId])
  @@index([drawId])
}

/// =======================
/// USER
/// =======================
model user {
  id        BigInt  @id @default(autoincrement())
  email     String? @unique
  password  String
  name      String
  adharcard String
  pancard   String
  address   String
  avatar    String? @db.LongText

  role     user_role @default(USER)
  isActive Boolean   @default(true)

  mobile String @unique

  // WALLET
  wallet Int @default(0)

  // REFERRAL
  referralCode String  @unique
  referredById BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referredBy user?  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  user[] @relation("UserReferrals")

  walletTransactions WalletTransaction[]

  notification notification[]
  payment      payment[]
  tickets      ticket[]       @relation("UserTickets")

  declaredWinners winner[] @relation("DeclaredBy")
  winners         winner[]
}

/// =======================
/// WALLET TRANSACTION
/// =======================
model WalletTransaction {
  id     BigInt @id @default(autoincrement())
  userId BigInt

  amount       Int
  balanceAfter Int

  type   wallet_transaction_type
  source wallet_transaction_source

  referenceId BigInt?
  remark      String?

  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@map("wallet_transaction")
}

/// =======================
/// WINNER
/// =======================
model winner {
  id         BigInt   @id @default(autoincrement())
  ticketId   BigInt   @unique
  productId  BigInt
  drawId     BigInt
  userId     BigInt
  declaredBy BigInt
  declaredAt DateTime @default(now())

  drawproduct drawproduct @relation(fields: [productId], references: [id])
  ticket      ticket      @relation(fields: [ticketId], references: [id])
  draw        draw        @relation(fields: [drawId], references: [id])
  user        user        @relation(fields: [userId], references: [id])
  admin       user        @relation("DeclaredBy", fields: [declaredBy], references: [id])

  @@index([productId])
  @@index([drawId])
  @@index([userId])
  @@index([declaredBy])
}

/// =======================
/// REFERRAL CONFIG
/// =======================
model referral_config {
  id            BigInt  @id @default(autoincrement())
  referrerBonus Int
  refereeBonus  Int
  isActive      Boolean @default(true)
}

/// =======================
/// ENUMS
/// =======================
enum user_role {
  USER
  ADMIN
}

enum ticket_source {
  USER_PURCHASE
  ADMIN_MANUAL
}

enum ticket_status {
  ACTIVE
  CANCELLED
  REFUNDED
}

enum payment_status {
  PENDING
  APPROVED
  REJECTED
}

enum draw_status {
  DRAFT
  LIVE
  CLOSED
  RESULT_DECLARED
}

enum payment_method {
  UPI
  CARD
  NET_BANKING
  WALLET
  CASH
}

enum payment_gateway {
  RAZORPAY
  STRIPE
  PAYTM
  MANUAL
}

enum wallet_transaction_type {
  CREDIT
  DEBIT
}

enum wallet_transaction_source {
  REFERRAL_BONUS
  DRAW_ENTRY
  REFUND
  ADMIN_ADJUSTMENT
  WIN_REWARD
}
